{
  "manifest_version": 3,
  "name": "Aurum Download Manager",
  "version": "0.1.0",
  "description": "选择由 Edge 或 Aurum 处理下载，并将链接发送到桌面下载器。",
  "permissions": ["downloads", "notifications", "contextMenus", "storage", "alarms", "nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Aurum 下载选择", "default_popup": "popup.html", "default_icon": "icon128.png" },
  "icons": { "128": "icon128.png" }
}
