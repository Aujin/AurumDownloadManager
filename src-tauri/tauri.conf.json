{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurum Download Manager",
  "version": "0.1.0",
  "identifier": "com.aujin.aurumdownloadmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Aurum Download Manager", "width": 1180, "height": 760, "minWidth": 860, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
